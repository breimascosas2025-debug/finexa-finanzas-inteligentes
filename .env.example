# GEMINI_API_KEY: Requerido para análisis OCR o Gemini.
# AI Studio lo inyecta automáticamente en tiempo de ejecución o desde secretos.
GEMINI_API_KEY=""

# NVIDIA_API_KEY: Clave PRIVADA del servidor para Finexa-Plus (Motor Neural GLM 5-3).
# Guarda aquí tu clave nvapi-... Esta clave NUNCA se expone al frontend ni a los navegadores de los usuarios.
NVIDIA_API_KEY=""

# Modelo subyacente para Finexa-Plus (por defecto GLM 5-3)
NVIDIA_MODEL="glm-5-3"

# Endpoint oficial de NVIDIA NIM
NVIDIA_ENDPOINT="https://integrate.api.nvidia.com/v1"

# Google OAuth Client ID para Google Identity Services (Frontend público)
VITE_GOOGLE_CLIENT_ID="19131670721-np7pl34gt6k2s1t3ku8g5du710q4vu3q.apps.googleusercontent.com"

# EmailJS Configuration para OTP y reseteo
VITE_EMAILJS_SERVICE_ID=""
VITE_EMAILJS_OTP_TEMPLATE_ID=""
VITE_EMAILJS_RESET_TEMPLATE_ID=""
VITE_EMAILJS_PUBLIC_KEY=""
